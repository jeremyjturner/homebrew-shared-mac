[30.6696, "o", "Changed the owner of /opt/homebrew to 'homebrew'.\r\n"]
[30.6771, "o", "Add the brew wrapper to /Users/admin/.zshrc? [y/N] "]
[32.1789, "o", "y"]
[32.2436, "o", "\r\n"]
